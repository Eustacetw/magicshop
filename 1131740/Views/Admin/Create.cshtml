@model _1131740.Models.Product
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <title>MagicShop - 上架新商品</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        body {
            background-color: #f4f7f6;
            font-family: "Microsoft JhengHei", sans-serif;
        }

        .form-container {
            max-width: 650px;
            margin: 40px auto;
            background: white;
            padding: 35px;
            border-radius: 15px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.05);
        }

        .form-label {
            font-weight: bold;
            color: #495057;
        }

        .form-control, .form-select {
            border-radius: 10px;
            padding: 10px;
            background: #f8f9fa;
        }
    </style>
</head>
<body class="p-3">

    <div class="form-container">
        <h4 class="fw-bold text-dark mb-4"><i class="fa-solid fa-plus text-success"></i> 上架全新遊戲專區</h4>

        <form asp-controller="Admin" asp-action="Create" method="post">
            <div class="mb-3">
                <label asp-for="ProductName" class="form-label">遊戲專區名稱</label>
                <input asp-for="ProductName" class="form-control" placeholder="例如：特戰英豪 (Valorant)" required />
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Category" class="form-label">商品分類</label>
                    <select asp-for="Category" class="form-select" required>
                        <option value="熱門遊戲">熱門遊戲</option>
                        <option value="UID儲值">UID儲值</option>
                        <option value="交友社交軟體">交友社交軟體</option>
                    </select>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Tag" class="form-label">活動標籤</label>
                    <input asp-for="Tag" class="form-control" placeholder="例如：熱門遊戲、官方直儲" required />
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Price" class="form-label text-primary">首頁顯示標價 (最低起步價)</label>
                <div class="input-group">
                    <span class="input-group-text bg-white">NT$</span>
                    <input asp-for="Price" type="number" class="form-control" placeholder="輸入最低起步價" required />
                    <span class="input-group-text bg-white">起</span>
                </div>
            </div>

            <div class="card mb-4 border-success bg-light">
                <div class="card-header bg-success text-white fw-bold small">
                    <i class="fa-solid fa-list-check"></i> 自訂儲值方案面額 (支援無限多組)
                </div>
                <div class="card-body">
                    <label class="form-label small fw-bold text-secondary">
                        請依照「名稱,價格」的格式輸入，每行代表一個方案（請使用半形逗號）
                    </label>
                    <textarea asp-for="AllPlansData" class="form-control bg-white" rows="6" placeholder="例如：
475 特務幣, 140
1000 特務幣, 290
2050 特務幣, 570
大份量 3650 特務幣, 980"></textarea>
                    <div class="form-text text-danger mt-2 small">
                        <i class="fa-solid fa-triangle-exclamation"></i> 注意：中間一定要有半形逗號「,」，且換行代表下一個方案。
                    </div>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="ImageUrl" class="form-label">遊戲封面圖片 (URL)</label>
                <input asp-for="ImageUrl" class="form-control" placeholder="請輸入以 https:// 開頭的圖片網址" required />
            </div>

            <div class="mb-4">
                <label asp-for="Description" class="form-label">專區簡短描述</label>
                <textarea asp-for="Description" class="form-control" rows="2" placeholder="請輸入儲值項目的規格或發貨說明"></textarea>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-success fw-bold w-100 btn-lg" style="border-radius: 10px;">確認上架</button>
                <a href="/Admin/Admin" class="btn btn-outline-secondary btn-lg w-100" style="border-radius: 10px;">取消</a>
            </div>
        </form>
    </div>

</body>
</html>