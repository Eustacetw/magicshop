@model _1131740.Models.RegisterViewModel
@{
    ViewData["Title"] = "會員註冊";
    Layout = null;
}

<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <title>MagicShop - 會員註冊</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #f4f7f6;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
        }

        .register-card {
            background: white;
            border-radius: 12px;
            box-shadow: 0 8px 24px rgba(0,0,0,0.1);
            padding: 35px;
            width: 100%;
            max-width: 450px;
        }
    </style>
</head>
<body>

    <div class="register-card">
        <h3 class="text-center fw-bold text-success mb-4">📝 註冊新會員</h3>

        @if (ViewBag.ErrorMessage != null)
        {
            <div class="alert alert-danger text-center">
                @ViewBag.ErrorMessage
            </div>
        }

        <form asp-controller="Account" asp-action="Register" method="post">
            <div class="mb-3">
                <label asp-for="Username" class="form-label fw-bold">設定帳號</label>
                <input asp-for="Username" class="form-control" placeholder="請輸入英文或數字" />
                <span asp-validation-for="Username" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label fw-bold">真實姓名</label>
                <input asp-for="Name" class="form-control" placeholder="請輸入您的姓名" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label fw-bold">設定密碼</label>
                <input asp-for="Password" class="form-control" placeholder="請輸入密碼" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label fw-bold">確認密碼</label>
                <input asp-for="ConfirmPassword" class="form-control" placeholder="請再次輸入密碼" />
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-success w-100 btn-lg mb-3">立即註冊</button>

            <div class="text-center">
                <a href="/Account/Login" class="text-decoration-none text-secondary">已經有帳號了？返回登入</a>
            </div>
        </form>
    </div>

</body>
</html>