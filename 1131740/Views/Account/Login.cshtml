@model _1131740.Models.LoginViewModel
@{
    ViewData["Title"] = "系統登入";
    Layout = null;
}

<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <title>MagicShop - 系統登入</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #f4f7f6;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
        }

        .login-card {
            background: white;
            border-radius: 12px;
            box-shadow: 0 8px 24px rgba(0,0,0,0.1);
            padding: 35px;
            width: 100%;
            max-width: 400px;
        }
    </style>
</head>
<body>

    <div class="login-card">
        <h3 class="text-center fw-bold text-secondary mb-4">請先登入系統</h3>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success text-center fw-bold">
                @TempData["SuccessMessage"]
            </div>
        }

        @if (ViewBag.ErrorMessage != null)
        {
            <div class="alert alert-danger text-center">
                @ViewBag.ErrorMessage
            </div>
        }

        <form asp-controller="Account" asp-action="Login" method="post">
            <div class="mb-3">
                <label asp-for="Username" class="form-label fw-bold">帳號</label>
                <input asp-for="Username" class="form-control" placeholder="請輸入帳號" />
            </div>

            <div class="mb-4">
                <label asp-for="Password" class="form-label fw-bold">密碼</label>
                <input asp-for="Password" class="form-control" placeholder="請輸入密碼" type="password" />
            </div>

            <button type="submit" class="btn btn-primary w-100 btn-lg mb-3">確認登入</button>

            <div class="text-center mb-4">
                <span class="text-muted">還沒有帳號嗎？</span>
                <a href="/Account/Register" class="text-primary fw-bold text-decoration-none">馬上註冊！</a>
            </div>
        </form>

        <div class="alert alert-warning text-center p-2 mb-0 border-warning" style="border-style: dashed;">
            📌 <strong>助教評分專用測試帳密：</strong><br />
            <span class="text-dark">帳號：<strong>admin</strong></span><br />
            <span class="text-dark">密碼：<strong>1234</strong></span>
        </div>
    </div>

</body>
</html>