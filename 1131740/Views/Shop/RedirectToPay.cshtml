@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <title>準備前往安全付款...</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        body {
            background-color: #f8f9fa;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
        }

        .redirect-box {
            background: white;
            padding: 40px;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.05);
            text-align: center;
        }

        .spinner-icon {
            font-size: 50px;
            color: #5c7cfa;
            margin-bottom: 20px;
        }
    </style>
</head>
<body>

    <div class="redirect-box">
        <i class="fa-solid fa-spinner fa-spin spinner-icon"></i>
        <h4 class="fw-bold mb-3">訂單建立成功！</h4>
        <p class="text-muted mb-0">正為您加密轉接至「速買配 SmilePay」安全支付環境...</p>
        <p class="text-danger small mt-2">請勿關閉視窗或重新整理頁面</p>
    </div>

    <form id="payForm" action="@ViewBag.SubmitUrl" method="post">
        @foreach (var item in ViewBag.SmilePayData)
        {
            <input type="hidden" name="@item.Key" value="@item.Value" />
        }
    </form>

    <script>

        setTimeout(function() {
            document.getElementById('payForm').submit();
        }, 1500);
    </script>
</body>
</html>