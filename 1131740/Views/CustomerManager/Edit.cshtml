@model _1131740.Models.Member
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <title>修改會員資料 - @Model.Username</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        body {
            background-color: #f4f7f6;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 20px;
        }

        .edit-card {
            background: white;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.06);
            border: none;
            padding: 40px;
            width: 100%;
            max-width: 500px;
        }
    </style>
</head>
<body>

    <div class="edit-card">
        <div class="text-center mb-4">
            <h4 class="fw-bold"><i class="fa-solid fa-user-pen text-primary me-2"></i>編輯會員資料與餘額</h4>
        </div>

        <form action="/CustomerManager/Edit" method="post">

            <div class="mb-3">
                <label class="form-label text-muted fw-bold small">登入帳號 (Username - 主鍵不可改)</label>
                <input type="text" name="Username" class="form-control bg-light" value="@Model.Username" readonly>
            </div>

            <div class="mb-3">
                <label class="form-label text-muted fw-bold small">登入密碼 (Password)</label>
                <input type="text" name="Password" class="form-control" value="@Model.Password" required>
            </div>

            <div class="mb-3">
                <label class="form-label text-muted fw-bold small">會員姓名 (Name)</label>
                <input type="text" name="Name" class="form-control" value="@Model.Name" required>
            </div>

            <div class="mb-3 mt-4">
                <label class="form-label text-success fw-bold small">真實商城餘額 (Balance)</label>
                <div class="input-group">
                    <span class="input-group-text bg-light text-success fw-bold">NT$</span>
                    <input type="number" name="Balance" class="form-control text-success fw-bold fs-5" value="@(Model.Balance ?? 0)">
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label text-danger fw-bold small">總累積消費紀錄 (TotalConsumed)</label>
                <div class="input-group">
                    <span class="input-group-text bg-light text-danger fw-bold">NT$</span>
                    <input type="number" name="TotalConsumed" class="form-control text-danger fw-bold fs-5" value="@(Model.TotalConsumed ?? 0)">
                </div>
            </div>

            <div class="d-flex gap-2 mt-4">
                <a href="/CustomerManager/Customer" class="btn btn-light w-50 fw-bold rounded-pill border">取消返回</a>
                <button type="submit" class="btn btn-primary w-50 fw-bold rounded-pill shadow-sm">寫入 SQL 資料庫</button>
            </div>
        </form>
    </div>

</body>
</html>